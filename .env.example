PORT=3000

# Microsoft Entra ID (protects /api/*)
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=                # Application (client) ID of the API app registration
AZURE_API_SCOPE=access_as_user      # delegated scope required on user tokens
AZURE_API_APP_ROLE=VendorLinks.Access  # app role required on service (client-credentials) tokens

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vendor_link
DB_USER=vendor_link
DB_PASSWORD=vendor_link

# QuickBooks Online (https://developer.intuit.com)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox            # sandbox | production
QBO_REDIRECT_URI=http://localhost:3000/auth/quickbooks/callback
# Optional if you connect via /auth/quickbooks/connect instead:
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_TOKEN_FILE=.qbo-tokens.json

# Samsara (token needs the "Read Work Orders" scope)
SAMSARA_API_TOKEN=
SAMSARA_BASE_URL=https://api.samsara.com
